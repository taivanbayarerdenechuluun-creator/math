# Copy to .env and fill in. Never commit real secrets.

# Database. SQLite for local development; PostgreSQL in production (see docs/DEPLOYMENT.md).
# The PostgreSQL database must be created with UTF8 encoding (the app stores Mongolian text).
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://intelliq:password@localhost:5432/intelliq"
# Vercel/serverless: DATABASE_URL = the POOLED url (Neon: the "-pooler" host, add ?pgbouncer=true&connect_timeout=15),
# DIRECT_URL = the non-pooled url, used for migrations and the seed during the build.
# DIRECT_URL=""

# REQUIRED. >= 32 random characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Public base URL (used in links inside emails, sitemap, Open Graph). Set it in production.
APP_URL="http://localhost:3000"

# ---- Email (verification, password reset) ----
# MAIL_PROVIDER = smtp | resend | console
#   console  prints the message to the server log; for development only
#   unset    console in development, NOTHING is sent in production (the app logs an error)
MAIL_PROVIDER=""
# From address, required for smtp and resend, e.g. INTELLIQ <no-reply@your.domain>
MAIL_FROM=""
# smtp
SMTP_HOST=""
SMTP_PORT="587"            # 465 switches on implicit TLS; otherwise STARTTLS is used when the server offers it
SMTP_USER=""
SMTP_PASS=""
# SMTP_SECURE="true"       # force implicit TLS
# SMTP_REQUIRE_TLS="true"  # refuse to send without STARTTLS
# SMTP_TLS_REJECT_UNAUTHORIZED="true"
# resend (https://resend.com)
RESEND_API_KEY=""
# RESEND_API_URL="https://api.resend.com"

# ---- File storage (avatars, question images) ----
# STORAGE_DRIVER = local (default, ./storage on disk) | s3 (AWS S3, Cloudflare R2, MinIO, ...)
# Files are always served through the app, so the bucket never needs to be public.
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION="us-east-1"      # "auto" for Cloudflare R2
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # only for non-AWS services
# S3_FORCE_PATH_STYLE="true"    # default: true when S3_ENDPOINT is set
# S3_PREFIX="intelliq/"         # optional key prefix, to share one bucket

# ---- Optional AI explanations on the results page (rule-based feedback is always available) ----
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Local/CI testing only; ignored when NODE_ENV=production.
# DISABLE_RATE_LIMIT=1
